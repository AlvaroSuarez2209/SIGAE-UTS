APP_ENV=testing
APP_KEY=
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sigae_uts_testing
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4

# phpunit.xml ya define esta misma variable para `php artisan test` — solo
# hace falta aquí si corres `php artisan db:seed-if-empty` a mano contra
# una base con APP_ENV=testing. Nunca una contraseña real.
ADMIN_INITIAL_PASSWORD=TestPassword123!
