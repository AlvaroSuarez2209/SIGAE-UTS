# Plantilla de referencia para las variables de entorno del panel de
# Render — no se carga automáticamente por Laravel (a diferencia de
# .env/.env.testing), es solo para copiar valores al panel web de Render.
# Ver "Despliegue en entorno de pruebas" en docs/manual-tecnico.md para el
# orden recomendado y de dónde sale cada valor.
#
# IMPORTANTE: este archivo se commitea al repositorio (no está en
# .gitignore, a propósito, para que sirva de plantilla) — nunca pegues
# aquí valores reales. Los valores reales van directo al panel de Render;
# si necesitas guardarlos localmente como referencia propia, usa
# `.env.render` (mismo nombre sin ".example", ya está en .gitignore y
# nunca se commitea).

APP_NAME=SIGAE-UTS
APP_ENV=production
APP_KEY=
# false en producción: con true, un error 500 expone el stack trace
# completo (rutas del servidor, y potencialmente valores del entorno) a
# quien lo provoque. Ver checklist de despliegue, sección 7.1.
APP_DEBUG=false
APP_URL=https://<tu-servicio>.onrender.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# --- Administrador inicial (ver database/seeders/UserSeeder.php) ---
# Contraseña real de admin@uts.edu.co — va SOLO en el panel de variables
# de entorno de Render, nunca en este archivo ni en ningún otro commiteado
# (ver auditoría de seguridad: antes vivía en texto plano en este
# repositorio). `db:seed-if-empty` falla con un mensaje claro si falta.
ADMIN_INITIAL_PASSWORD=

# stderr, no stack: el canal 'stack' (single) escribe a
# storage/logs/laravel.log, un archivo *dentro* del contenedor — se
# pierde en cada reinicio/redeploy y nunca aparece en la pestaña "Logs"
# de Render. 'stderr' (ya definido en config/logging.php) escribe a la
# salida estándar de error, que es exactamente lo que Render captura y
# muestra. Ver docs/manual-tecnico.md §8.1.
LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Neon Postgres ---
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Neon exige SSL y rechaza la conexión sin esto — a diferencia de local
# (sin este valor, config/database.php usa 'prefer' por defecto).
DB_SSLMODE=require
# Host DIRECTO de Neon (sin el sufijo "-pooler") — usado solo por
# "migrate --force" en docker/start.sh, nunca por el resto de la app
# (que sigue usando el DB_HOST pooled de arriba). En el panel de Neon,
# junto al connection string "Pooled connection" hay uno sin ese
# sufijo — ese es el que va aquí. Ver docs/manual-tecnico.md §8.
DB_HOST_MIGRATE=

# --- Sesión ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
# true aquí (a diferencia de local): Render sirve por HTTPS, así que la
# cookie de sesión sí debe llevar el flag Secure. Ver checklist de
# despliegue, sección 7.1.
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
# Se mantiene en database: la cola no la procesa un worker persistente
# (Render free no lo ofrece), sino GET /cron/process-queue disparado por
# un cron externo — ver más abajo y la sección de despliegue.
QUEUE_CONNECTION=database
# DatabaseQueue::pop() (lo que "queue:work" corre en cada job) tiene la
# misma forma que el increment() del caché que rompía el login: un
# SELECT ... FOR UPDATE + UPDATE dentro de una única transacción — mismo
# riesgo con el pooler de Neon, aplicado preventivamente antes de verlo
# fallar en un log real. config/queue.php ya soporta esto de forma
# nativa (la conexión "database" de colas tiene su propio
# 'connection' => env('DB_QUEUE_CONNECTION')), así que no hace falta
# ningún cambio de código: apuntarlo al host directo de Neon (el mismo
# de DB_HOST_MIGRATE) basta. El resto de la app sigue en DB_CONNECTION
# (pgsql, pooled) sin cambios — verificado que ambas conexiones
# conviven sin cruzarse. Ver docs/manual-tecnico.md §8.1.
DB_QUEUE_CONNECTION=pgsql_migrate
# file, no database: RateLimiter::hit() (login/"olvidé mi contraseña")
# hace un increment() atómico sobre la tabla cache — Illuminate\Cache\
# DatabaseStore envuelve eso en una transacción con SELECT ... FOR UPDATE
# + UPDATE, y el pooler de Neon (PgBouncer en modo transaction pooling)
# rompe esa transacción igual que rompía las migraciones. Confirmado con
# el log real: SQLSTATE[25P02] "current transaction is aborted" en un
# UPDATE sobre "cache" al fallar un login. 'file' no tiene este problema
# (no pasa por Postgres) y es correcto para un despliegue de una sola
# instancia como este — no hay otra instancia con la que compartir el
# caché. Ver docs/manual-tecnico.md §8.1.
CACHE_STORE=file

# --- Brevo (API HTTP, NO SMTP) ---
# Render bloquea el tráfico saliente por los puertos SMTP (25/465/587) en
# su plan gratuito desde septiembre de 2025 — es una política de la
# plataforma, no un error de configuración; Brevo por SMTP nunca va a
# funcionar aquí, sin importar el proveedor. La API HTTP de Brevo corre
# por HTTPS (443, no bloqueado). MAIL_MAILER=brevo usa el transporte
# registrado en AppServiceProvider::registerBrevoApiMailTransport() (vía
# symfony/brevo-mailer), no el mailer "smtp" de config/mail.php.
MAIL_MAILER=brevo
# API Key de Brevo — NO la clave SMTP que se usaba antes, son
# credenciales distintas dentro del mismo panel de Brevo. Se genera en
# brevo.com → SMTP & API → pestaña "API Keys" (aparte de la pestaña
# "SMTP") → "Generate a new API key".
BREVO_API_KEY=
MAIL_FROM_ADDRESS="no-responder@sigae-uts.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Cron externo para procesar la cola (ver routes/web.php:
# GET /cron/process-queue) ---
# Generar un valor aleatorio largo (ej. `php artisan tinker --execute="echo
# Str::random(40);"` en local) y pegarlo igual acá y en la URL configurada
# en cron-job.org (?token=...).
CRON_SECRET=
