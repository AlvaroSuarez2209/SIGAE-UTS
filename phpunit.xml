<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!-- Cambio (vaciado inmediato de la cola de correo): defer() crea un
         contenedor de callbacks diferidos nuevo por cada test (fresco en
         cada setUp(), ver Illuminate\Foundation\Testing\TestCase) —
         agregarlo a los puntos que ya encolaban correo (Evidence,
         Deliverable, User, LeadershipForm) hace que cientos de tests
         existentes, que antes no tocaban ese mecanismo, ahora sí lo
         registren. El recolector de basura de PHP no siempre libera esos
         objetos muertos (closures + modelos Eloquent capturados) tan
         rápido como se acumulan en una sola corrida de ~930 tests en un
         único proceso — sin esto, la suite completa agota el límite por
         defecto de 128M antes de terminar (verificado: con 512M/1024M
         pasa igual, mismos 976 tests, sin ningún cambio de comportamiento,
         solo más margen). -->
    <php>
        <ini name="memory_limit" value="512M"/>
        <!-- Solo para que UserSeeder (y los tests que corren db:seed-if-empty)
             tengan un valor determinista — nunca la contraseña real, que va
             en .env local o en el panel de Render, nunca en el repositorio. -->
        <env name="ADMIN_INITIAL_PASSWORD" value="TestPassword123!"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- <env name="DB_CONNECTION" value="sqlite"/> -->
        <!-- <env name="DB_DATABASE" value=":memory:"/> -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
